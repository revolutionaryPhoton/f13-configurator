{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "F13 Configurator",
  "version": "0.1.0",
  "identifier": "de.f13-os.configurator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "F13 Configurator",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Shell configurator for a minimal F13 deployment",
    "longDescription": "A desktop GUI that walks you through deploying a minimal F13 instance — core API, frontend, and chat — without hand-editing YAML."
  }
}
