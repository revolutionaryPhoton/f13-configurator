#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LIB_DIR="${SCRIPT_DIR}/../lib"
readonly TMPL_DIR="${SCRIPT_DIR}/../templates"
# F13_GENERATED_DIR may be overridden in tests to use a tmp directory
GEN_DIR="${F13_GENERATED_DIR:-${SCRIPT_DIR}/../generated}"

# shellcheck source=../lib/events.sh
source "${LIB_DIR}/events.sh"
# shellcheck source=../lib/ui.sh
source "${LIB_DIR}/ui.sh"
# shellcheck source=../lib/banner.sh
source "${LIB_DIR}/banner.sh"
# shellcheck source=../lib/prompt.sh
source "${LIB_DIR}/prompt.sh"
# shellcheck source=../lib/secrets.sh
source "${LIB_DIR}/secrets.sh"
# shellcheck source=../lib/ports.sh
source "${LIB_DIR}/ports.sh"
# shellcheck source=../lib/preflight.sh
source "${LIB_DIR}/preflight.sh"
# shellcheck source=../lib/render.sh
source "${LIB_DIR}/render.sh"
# shellcheck source=../lib/ollama.sh
source "${LIB_DIR}/ollama.sh"
# shellcheck source=../lib/compose.sh
source "${LIB_DIR}/compose.sh"
# shellcheck source=../lib/state.sh
source "${LIB_DIR}/state.sh"
# shellcheck source=../lib/frontend.sh
source "${LIB_DIR}/frontend.sh"

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------

usage() {
  cat <<'EOF'
Usage: f13-config [OPTIONS]

  Stand up a minimal F13 deployment (core + frontend + chat).

Options:
  --non-interactive   Drive wizard from environment variables (no prompts)
  --dry-run           Render templates but do not launch containers
  --reset             Wipe generated/ and start over (asks for confirmation)
  --emit-events       Print structured JSON events to stdout (GUI mode)
  --preflight-only    Run preflight checks and exit (use with --emit-events)
  --detect-state      Emit current state and exit (use with --emit-events)
  --list-models       Emit available Ollama models and exit
  --check-port PORT   Emit port availability for PORT and exit
  --compose-up        Start containers and wait healthy (use with --emit-events)
  --compose-health    Emit current health status and exit
  --help              Show this help and exit

Environment variables (for --non-interactive):
  CHAT_BACKEND        mock | ollama  (default: mock)
  OLLAMA_MODEL        model name when CHAT_BACKEND=ollama
  FRONTEND_PORT       host port for the frontend  (default: 9999)
  CORE_PORT           host port for the core API  (default: 8000)

Internal / test overrides:
  F13_GENERATED_DIR   Override path for the generated/ output directory
  F13_SKIP_PREFLIGHT  Set to 1 to skip preflight checks (testing only)
  F13_SKIP_BUILD      Set to 1 to skip docker build of patched frontend image
EOF
}

# ---------------------------------------------------------------------------
# Wizard steps
# ---------------------------------------------------------------------------

_wizard_reset() {
  if [[ ! -d "${GEN_DIR}" ]]; then
    ui::info "Nothing to reset — generated/ does not exist."
    return 0
  fi
  if prompt::yesno "Delete generated/ and start fresh?" "n"; then
    rm -rf "${GEN_DIR}"
    ui::ok "generated/ wiped."
  else
    ui::info "Reset cancelled."
    exit 0
  fi
}

# HF4 neighbour: edit/reset reconfigure flows must take down the
# running stack before preflight, otherwise the new compose collides
# with the previous run's containers on the same ports. No-op when
# there is no rendered compose file to act on or when --dry-run was
# requested (dry-run must not touch Docker).
_wizard_stop_running_stack() {
  local _dry_run="${1:-0}"
  if [[ ! -f "${GEN_DIR}/docker-compose.yml" ]]; then
    return 0
  fi
  events::emit step "name=stop" "status=started"
  if [[ "${_dry_run}" -eq 1 ]]; then
    events::emit step "name=stop" "status=done" "skipped=true"
    return 0
  fi
  ui::step "Stopping running services..."
  compose::down
  events::emit step "name=stop" "status=done"
  printf '\n'
}

_wizard_pick_inference() {
  if [[ -n "${F13_CONFIG_NONINTERACTIVE:-}" ]]; then
    CHAT_BACKEND="${CHAT_BACKEND:-mock}"
    return 0
  fi

  local _choice
  prompt::pickone _choice "Where should chat inference run?" \
    "🧪 Mock inference (no GPU, deterministic responses)" \
    "🦙 Host Ollama (connects to ollama serve on this machine)"

  case "${_choice}" in
    *"Mock"*|*"mock"*) CHAT_BACKEND="mock"   ;;
    *)                  CHAT_BACKEND="ollama" ;;
  esac
}

_wizard_pick_ollama_model() {
  if [[ -n "${F13_CONFIG_NONINTERACTIVE:-}" ]]; then
    OLLAMA_MODEL="${OLLAMA_MODEL:-gemma4:31b-cloud}"
    return 0
  fi

  ui::warn "Heads-up on Ollama models:"
  printf '   • %s\n' \
    "Local models need enough VRAM/RAM for the chosen size — without a" \
    "  capable GPU, responses can take many seconds per token." \
    "Cloud-hosted models (tags ending in ':cloud') require a signed-in" \
    "  Ollama account on this machine — run 'ollama signin' first if" \
    "  you haven't already." \
    "Embedding models (e.g. nomic-embed-text, *-embed-*, *-embedding-*)" \
    "  produce vector outputs, not chat completions. They may appear in" \
    "  the list below — please don't pick one for chat inference."
  printf '\n'

  while ! ollama::is_running; do
    ui::warn "Ollama is not running. Start it with: ollama serve"
    if ! prompt::yesno "Retry connection?" "y"; then
      ui::err "Ollama required for this inference. Aborting."
      exit 1
    fi
  done

  local -a _models=()
  mapfile -t _models < <(ollama::list_models 2>/dev/null || true)

  if [[ ${#_models[@]} -eq 0 ]]; then
    ui::warn "No models found. Pull one with: ollama pull gemma4:31b-cloud"
    prompt::ask OLLAMA_MODEL "Enter model name" "gemma4:31b-cloud"
    return 0
  fi

  # Prefer gemma4:31b-cloud as default if present, else first model
  local _default="${_models[0]}"
  local _m
  for _m in "${_models[@]}"; do
    [[ "${_m}" == "gemma4:31b-cloud" ]] && _default="gemma4:31b-cloud" && break
  done

  # Build menu with default first
  local -a _menu=()
  if [[ "${_models[0]}" == "${_default}" ]]; then
    _menu=("${_models[@]}")
  else
    _menu=("${_default}")
    for _m in "${_models[@]}"; do
      [[ "${_m}" != "${_default}" ]] && _menu+=("${_m}")
    done
  fi

  local _pick
  prompt::pickone _pick "Pick a model" "${_menu[@]}"
  OLLAMA_MODEL="${_pick}"
}

_wizard_pick_ports() {
  local _sf _sc
  _sf="$(ports::pick_free 9999 9998 9997 9996 2>/dev/null || printf '9999')"
  _sc="$(ports::pick_free 8000 8001 8002 8003 2>/dev/null || printf '8000')"

  if [[ -z "${FRONTEND_PORT:-}" ]]; then
    prompt::ask FRONTEND_PORT "Frontend port" "${_sf}"
  fi
  if [[ -z "${CORE_PORT:-}" ]]; then
    prompt::ask CORE_PORT "Core API port" "${_sc}"
  fi
}

_wizard_build_frontend() {
  local _dry_run="${1:-0}"
  if [[ "${_dry_run}" -eq 1 ]]; then
    ui::info "Dry-run — skipping frontend image build."
    return 0
  fi

  if [[ -n "${F13_CONFIG_NONINTERACTIVE:-}" ]]; then
    if [[ -z "${F13_SKIP_BUILD:-}" ]]; then
      frontend::patch_and_build "${FRONTEND_IMAGE}"
    else
      ui::info "F13_SKIP_BUILD set — skipping frontend image build."
    fi
    return 0
  fi

  if frontend::image_exists "${FRONTEND_IMAGE}"; then
    if ! prompt::yesno "Patched frontend image found. Rebuild?" "n"; then
      ui::info "Using cached image: ${FRONTEND_IMAGE}"
      return 0
    fi
  fi

  ui::step "Building patched frontend image..."
  frontend::patch_and_build "${FRONTEND_IMAGE}"
}

_wizard_generate_secrets() {
  local _sd="${GEN_DIR}/secrets"
  mkdir -p "${_sd}"

  # Reuse the existing feedback_db password if the secret file is
  # already on disk and non-empty. Without this, the `edit` re-run
  # path would generate a fresh password while the postgres named
  # volume `feedback-db-data` keeps its old one — core then can't
  # auth and stays unhealthy. `reset` is the destructive path that
  # wipes the volume; `edit` should preserve user data.
  local _fdb="${_sd}/feedback_db.secret"
  if [[ -z "${FEEDBACK_DB_PASSWORD:-}" && -s "${_fdb}" ]]; then
    FEEDBACK_DB_PASSWORD="$(< "${_fdb}")"
  fi
  if [[ -z "${FEEDBACK_DB_PASSWORD:-}" ]]; then
    FEEDBACK_DB_PASSWORD="$(secret::gen 24)"
  fi

  # Write the password into the secret file core reads at /core/secrets/feedback_db.secret
  # 0644 (not 0600) so the non-root container user can read it through the
  # Docker bind-mount on Linux. Same rationale as secret::write in lib/secrets.sh.
  printf '%s' "${FEEDBACK_DB_PASSWORD}" > "${_fdb}"
  chmod 644 "${_fdb}"

  # Placeholder secrets for future presets — idempotent (no --force)
  secret::write "${_sd}/llm_api.secret"
  secret::write "${_sd}/transcription_db.secret"
  secret::write "${_sd}/rabbitmq.secret"
  secret::write "${_sd}/rustfs.secret"
  secret::write "${_sd}/huggingface_token.secret"
}

_wizard_compute_vars() {
  # Pinned chat image — both backends use the same tagged release
  # (registry.opencode.de/.../chat:vX.Y.Z) so behavior matches what
  # F13 documentation describes for that version.
  local _chat_image="registry.opencode.de/f13/microservices/chat:v1.2.0"

  if [[ "${CHAT_BACKEND}" == "mock" ]]; then
    CHAT_IMAGE="${_chat_image}"
    CHAT_BASE_URL="http://ollama-mock:11434/v1"
    CHAT_MODEL_NAME="test_model:mock"
    CHAT_MAX_CONTEXT_TOKENS="4096"
    CHAT_MODEL_ID="test_model_mock"
    COMPOSE_PROFILES="mock"
  else
    CHAT_IMAGE="${_chat_image}"
    CHAT_BASE_URL="$(ollama::host_url_for_docker)"
    CHAT_MODEL_NAME="${OLLAMA_MODEL}"
    CHAT_MAX_CONTEXT_TOKENS="8192"
    CHAT_MODEL_ID="local_ollama"
    COMPOSE_PROFILES=""
  fi
}

_wizard_render() {
  mkdir -p "${GEN_DIR}/configs/core" "${GEN_DIR}/configs/chat" \
    "${GEN_DIR}/configs/apisix" "${GEN_DIR}/opa/policies" "${GEN_DIR}/secrets"

  export FRONTEND_PORT CORE_PORT CHAT_BACKEND OLLAMA_MODEL FEEDBACK_DB_PASSWORD \
    CHAT_IMAGE CHAT_BASE_URL CHAT_MODEL_NAME CHAT_MAX_CONTEXT_TOKENS \
    CHAT_MODEL_ID COMPOSE_PROFILES ENABLED_FEATURES FRONTEND_IMAGE

  render::file "${TMPL_DIR}/docker-compose.yml.tmpl" "${GEN_DIR}/docker-compose.yml"
  render::file "${TMPL_DIR}/env.tmpl"                "${GEN_DIR}/.env"
  render::file "${TMPL_DIR}/core/general.yml.tmpl"   "${GEN_DIR}/configs/core/general.yml"
  render::file "${TMPL_DIR}/core/llm_models.yml.tmpl" "${GEN_DIR}/configs/core/llm_models.yml"
  render::file "${TMPL_DIR}/chat/general.yml.tmpl"   "${GEN_DIR}/configs/chat/general.yml"
  render::file "${TMPL_DIR}/chat/llm_models.yml.tmpl" "${GEN_DIR}/configs/chat/llm_models.yml"
  render::file "${TMPL_DIR}/chat/agentic_chat.yml.tmpl" "${GEN_DIR}/configs/chat/agentic_chat.yml"

  # prompt_maps.yml has no template vars — copy from the bundled template.
  # Vendored at templates/chat/prompt_maps.yml so the path resolves regardless
  # of how the wizard was invoked (CLI, GUI, packaged sidecar).
  cp "${TMPL_DIR}/chat/prompt_maps.yml" "${GEN_DIR}/configs/chat/prompt_maps.yml"

  # APISIX route/config files use the gateway's own ${{VAR:=default}}
  # runtime substitution (resolved from the container's env at APISIX
  # startup, e.g. CORS_ALLOW_ORIGINS above) — not our envsubst allow-list.
  # Copy them through unmodified from the vendored v3 reference.
  cp "${TMPL_DIR}/core/apisix/apisix-guest.yaml"  "${GEN_DIR}/configs/apisix/apisix-guest.yaml"
  cp "${TMPL_DIR}/core/apisix/config-guest.yaml"  "${GEN_DIR}/configs/apisix/config-guest.yaml"
  cp "${TMPL_DIR}/core/apisix/apisix.yaml"        "${GEN_DIR}/configs/apisix/apisix.yaml"
  cp "${TMPL_DIR}/core/apisix/config.yaml"        "${GEN_DIR}/configs/apisix/config.yaml"

  # OPA policy set has no template vars — vendored verbatim from the v3
  # chat reference, same pattern as the apisix files above.
  cp "${TMPL_DIR}/chat/opa/policies/permissions.rego" \
    "${GEN_DIR}/opa/policies/permissions.rego"
  cp "${TMPL_DIR}/chat/opa/policies/test_permissions.rego" \
    "${GEN_DIR}/opa/policies/test_permissions.rego"
}

_wizard_summary_box() {
  local _model_label
  if [[ "${CHAT_BACKEND}" == "mock" ]]; then
    _model_label="test_model:mock (deterministic)"
  else
    _model_label="${OLLAMA_MODEL}"
  fi

  ui::box "F13 Configuration Summary" <<EOF
Preset:    core + frontend + chat (Keycloak guest mode)
Inference: ${CHAT_BACKEND}
Model:     ${_model_label}
Frontend:  http://localhost:${FRONTEND_PORT}
API:       http://localhost:${CORE_PORT}
Output:    ${GEN_DIR}
EOF
}

# ---------------------------------------------------------------------------
# Main wizard flow
# ---------------------------------------------------------------------------

wizard() {
  local _dry_run="${1:-0}"

  # Initialise wizard state from environment (or defaults)
  CHAT_BACKEND="${CHAT_BACKEND:-}"
  OLLAMA_MODEL="${OLLAMA_MODEL:-}"
  FRONTEND_PORT="${FRONTEND_PORT:-}"
  CORE_PORT="${CORE_PORT:-}"
  FEEDBACK_DB_PASSWORD="${FEEDBACK_DB_PASSWORD:-}"
  CHAT_IMAGE=""
  CHAT_BASE_URL=""
  CHAT_MODEL_NAME=""
  CHAT_MAX_CONTEXT_TOKENS=""
  CHAT_MODEL_ID=""
  COMPOSE_PROFILES=""
  # v1 preset: only chat is active; image built locally by this wizard
  ENABLED_FEATURES="chat"
  FRONTEND_IMAGE="${FRONTEND_IMAGE_TAG}"

  ui::banner
  printf '\n'

  # Idempotency check — if a previous run exists, ask how to proceed.
  # Only blank F13_STATE_ACTION when the env did NOT set it; otherwise
  # the GUI's reconfigure flow (which exports F13_STATE_ACTION=edit
  # before invoking the wizard) would be silently downgraded to "keep"
  # because state::check defaults the empty case to keep. Same class of
  # bug as the state::read clobber fix in this branch.
  F13_STATE_ACTION="${F13_STATE_ACTION:-}"
  if state::check "${GEN_DIR}"; then
    case "${F13_STATE_ACTION}" in
      keep)
        state::read "${GEN_DIR}/.state"
        _wizard_compute_vars
        _wizard_summary_box
        printf '\n'
        # Emit synthetic done+skipped events for stages that ran in the previous wizard pass.
        events::emit_skipped secrets
        events::emit_skipped render
        events::emit_skipped build
        if [[ "${_dry_run}" -ne 1 ]] && prompt::yesno "Start it now?" "y"; then
          ui::step "Starting F13..."
          events::emit step "name=start" "status=started"
          compose::up
          events::emit step "name=start" "status=done"
        else
          ui::info "Run manually: cd ${GEN_DIR} && docker compose up -d"
        fi
        events::emit 'done' "status=ok"
        return 0
        ;;
      edit)
        # HF4: bring the running stack down before preflight so the
        # ports the user just configured (or kept) aren't blocked by
        # the previous run's containers. Skipped on --dry-run.
        _wizard_stop_running_stack "${_dry_run}"
        state::read "${GEN_DIR}/.state"
        ui::info "Editing configuration. Current values used as defaults."
        printf '\n'
        ;;
      reset)
        # Same rationale as edit — kill the live stack before wiping
        # generated/ and re-rendering. rm -rf would leave dangling
        # containers attached to a now-missing compose file.
        _wizard_stop_running_stack "${_dry_run}"
        rm -rf "${GEN_DIR}"
        ui::ok "generated/ wiped. Starting fresh."
        printf '\n'
        ;;
    esac
  fi

  # Step 1 — preflight
  if [[ -z "${F13_SKIP_PREFLIGHT:-}" ]]; then
    events::emit step "name=preflight" "status=started"
    ui::step "1. Preflight checks"
    local _pf_failed=0
    preflight::run || _pf_failed=1
    if [[ "${_pf_failed}" -eq 1 ]]; then
      events::emit step "name=preflight" "status=fail" "message=preflight checks failed"
      events::emit 'done' "status=error" "message=preflight checks failed"
      return 1
    fi
    events::emit step "name=preflight" "status=done"
    printf '\n'
  fi

  # Step 2 — confirm preset
  ui::info "Preset: core + frontend + chat — Keycloak guest mode (no login required)"
  printf '\n'
  if ! prompt::yesno "Continue with this preset?" "y"; then
    ui::info "Aborted."
    exit 0
  fi
  printf '\n'

  # Step 3 — chat inference
  ui::step "2. Chat inference"
  _wizard_pick_inference

  if [[ "${CHAT_BACKEND}" == "ollama" ]]; then
    _wizard_pick_ollama_model
  fi
  printf '\n'

  # Step 4 — ports
  ui::step "3. Ports"
  _wizard_pick_ports
  printf '\n'

  # Step 4b — build patched frontend image
  events::emit step "name=build" "status=started"
  ui::step "4. Building patched frontend image"
  _wizard_build_frontend "${_dry_run}"
  events::emit step "name=build" "status=done"
  printf '\n'

  # Step 5 — secrets
  events::emit step "name=secrets" "status=started"
  ui::step "5. Generating secrets"
  _wizard_generate_secrets
  ui::ok "Secrets written to ${GEN_DIR}/secrets/"
  events::emit step "name=secrets" "status=done"
  printf '\n'

  # Derive template variables from chosen config
  _wizard_compute_vars

  # Step 6 — render
  events::emit step "name=render" "status=started"
  ui::step "6. Rendering configuration"
  _wizard_render
  state::write "${GEN_DIR}/.state"
  ui::ok "Configuration written to ${GEN_DIR}/"
  events::emit step "name=render" "status=done"
  printf '\n'

  # Step 7 — summary
  _wizard_summary_box
  printf '\n'

  if [[ "${_dry_run}" -eq 1 ]]; then
    ui::info "Dry-run mode — skipping launch."
    events::emit 'done' "status=ok"
    return 0
  fi

  # Step 8 — optional launch
  if prompt::yesno "Start it now?" "y"; then
    ui::step "7. Starting F13..."
    events::emit step "name=start" "status=started"
    compose::up
    events::emit step "name=start" "status=done"
  else
    ui::info "Run manually: cd ${GEN_DIR} && docker compose up -d"
  fi
  events::emit 'done' "status=ok"
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

main() {
  local _dry_run=0
  local _do_reset=0
  local _mode="wizard"
  local _check_port_num=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h)
        usage
        exit 0
        ;;
      --non-interactive)
        export F13_CONFIG_NONINTERACTIVE=1
        ;;
      --dry-run)
        _dry_run=1
        ;;
      --reset)
        _do_reset=1
        ;;
      --emit-events)
        export F13_EMIT_EVENTS=1
        ;;
      --preflight-only)
        _mode="preflight-only"
        ;;
      --detect-state)
        _mode="detect-state"
        ;;
      --list-models)
        _mode="list-models"
        ;;
      --check-port)
        _mode="check-port"
        shift
        _check_port_num="${1:?--check-port requires a port number}"
        ;;
      --compose-up)
        _mode="compose-up"
        ;;
      --compose-health)
        _mode="compose-health"
        ;;
      *)
        ui::err "Unknown option: $1"
        usage >&2
        exit 1
        ;;
    esac
    shift
  done

  case "${_mode}" in
    preflight-only)
      local _pf_failed=0
      preflight::run || _pf_failed=1
      if [[ "${_pf_failed}" -eq 0 ]]; then
        events::emit 'done' "status=ok"
      else
        events::emit 'done' "status=error" "message=preflight checks failed"
      fi
      exit "${_pf_failed}"
      ;;

    detect-state)
      if [[ ! -f "${GEN_DIR}/.state" ]]; then
        events::emit state "exists=false"
      else
        local _preset _backend _model _fport _cport _ts
        _preset="$(grep '^PRESET='        "${GEN_DIR}/.state" | cut -d= -f2- || true)"
        _backend="$(grep '^CHAT_BACKEND='  "${GEN_DIR}/.state" | cut -d= -f2- || true)"
        _model="$(grep '^OLLAMA_MODEL='   "${GEN_DIR}/.state" | cut -d= -f2- || true)"
        _fport="$(grep '^FRONTEND_PORT='  "${GEN_DIR}/.state" | cut -d= -f2- || true)"
        _cport="$(grep '^CORE_PORT='      "${GEN_DIR}/.state" | cut -d= -f2- || true)"
        _ts="$(grep '^TIMESTAMP='         "${GEN_DIR}/.state" | cut -d= -f2- || true)"
        events::emit state "exists=true" \
          "preset=${_preset}" "backend=${_backend}" "ollama_model=${_model}" \
          "frontend_port=${_fport}" "core_port=${_cport}" "timestamp=${_ts}"
      fi
      ;;

    list-models)
      if ollama::is_running; then
        local -a _lm_models=()
        mapfile -t _lm_models < <(ollama::list_models 2>/dev/null || true)
        if [[ ${#_lm_models[@]} -gt 0 ]]; then
          local _joined
          _joined="$(printf '%s ' "${_lm_models[@]}")"
          _joined="${_joined% }"
          events::emit models "status=running" "models=${_joined}"
        else
          events::emit models "status=running" "models="
        fi
      else
        events::emit models "status=not-running"
      fi
      ;;

    check-port)
      if ports::is_free "${_check_port_num}"; then
        events::emit port "port=${_check_port_num}" "status=free"
      else
        local _pid="" _pname=""
        if command -v lsof &>/dev/null; then
          _pid="$(lsof -iTCP:"${_check_port_num}" -sTCP:LISTEN -t 2>/dev/null | head -1 || true)"
          if [[ -n "${_pid}" ]]; then
            _pname="$(ps -p "${_pid}" -o comm= 2>/dev/null || true)"
          fi
        fi
        events::emit port "port=${_check_port_num}" "status=taken" \
          "pid=${_pid}" "name=${_pname}"
      fi
      ;;

    compose-up)
      if [[ -f "${GEN_DIR}/.state" ]]; then
        state::read "${GEN_DIR}/.state"
      fi
      CORE_PORT="${CORE_PORT:-8000}"
      FRONTEND_PORT="${FRONTEND_PORT:-9999}"
      events::emit compose "action=up" "status=started"
      local _cu_failed=0
      COMPOSE_ERROR_MESSAGE=""
      compose::up || _cu_failed=1
      if [[ "${_cu_failed}" -eq 0 ]]; then
        events::emit compose "action=up" "status=healthy"
        events::emit 'done' "status=ok"
      else
        # HF3: surface the specific failure reason if compose::up stashed
        # one (e.g. the frontend-image-missing precondition). Falls back
        # to the generic message otherwise.
        local _msg="${COMPOSE_ERROR_MESSAGE:-compose up failed}"
        events::emit compose "action=up" "status=error"
        events::emit 'done' "status=error" "message=${_msg}"
        exit 1
      fi
      ;;

    compose-health)
      if [[ -f "${GEN_DIR}/.state" ]]; then
        state::read "${GEN_DIR}/.state"
      fi
      local _hport="${CORE_PORT:-8000}"
      if compose::_curl_health "http://localhost:${_hport}/health"; then
        events::emit health "status=healthy"
      else
        events::emit health "status=unhealthy" "message=core not responding"
      fi
      ;;

    wizard)
      if [[ "${_do_reset}" -eq 1 ]]; then
        _wizard_reset
      fi
      wizard "${_dry_run}"
      ;;
  esac
}

main "$@"
