#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GEN_DIR="${F13_GENERATED_DIR:-${SCRIPT_DIR}/../generated}"

# shellcheck source=../lib/events.sh
source "${SCRIPT_DIR}/../lib/events.sh"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --emit-events) export F13_EMIT_EVENTS=1 ;;
    *) ;;
  esac
  shift
done

if [[ ! -f "${GEN_DIR}/docker-compose.yml" ]]; then
  events::emit compose "action=down" "status=error" "message=no generated stack found"
  echo "❌  No generated stack found at ${GEN_DIR}" >&2
  exit 1
fi

events::emit compose "action=down" "status=started"
echo "⏹️  Stopping F13..."
docker compose -f "${GEN_DIR}/docker-compose.yml" --env-file "${GEN_DIR}/.env" down
events::emit compose "action=down" "status=stopped"
echo "✅  F13 stopped. Data volumes preserved."
events::emit 'done' "status=ok"
