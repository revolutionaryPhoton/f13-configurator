#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=../lib/events.sh
source "${SCRIPT_DIR}/../lib/events.sh"
# shellcheck source=../lib/discover.sh
source "${SCRIPT_DIR}/../lib/discover.sh"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --emit-events) export F13_EMIT_EVENTS=1 ;;
    *) ;;
  esac
  shift
done

if ! GEN_DIR="$(discover::generated_dir "${SCRIPT_DIR}")"; then
  events::emit compose "action=reset" "status=error" "message=no generated stack found"
  echo "❌  No generated stack found." >&2
  echo "    Run f13-config first, or set F13_GENERATED_DIR." >&2
  exit 1
fi

if [[ ! -f "${GEN_DIR}/docker-compose.yml" ]]; then
  events::emit compose "action=reset" "status=error" "message=no generated stack found"
  echo "❌  No generated stack found at ${GEN_DIR}" >&2
  exit 1
fi

events::emit compose "action=reset" "status=started"
echo "🗑️  Stopping F13 and removing all data volumes..."
docker compose -f "${GEN_DIR}/docker-compose.yml" --env-file "${GEN_DIR}/.env" down -v
events::emit compose "action=reset" "status=stopped"
echo "🧹  Removing generated config..."
rm -rf "${GEN_DIR}"
events::emit 'done' "status=ok"
echo "✅  Full reset done. Run ./bin/f13-config to configure and start again."
