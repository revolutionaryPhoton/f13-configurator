services:
  frontend:
    image: ${FRONTEND_IMAGE}
    # HF3: the frontend image is built locally by this configurator
    # (frontend::patch_and_build) and is never pushed to any registry,
    # so a missing image must surface as a clear precondition error,
    # not a confusing "pull access denied" against registry.opencode.de.
    pull_policy: never
    environment:
      KEYCLOAK_DISABLED: "true"
      ENABLED_FEATURES: "${ENABLED_FEATURES}"
    ports:
      - "${FRONTEND_PORT}:9999"
    depends_on:
      - core
    restart: unless-stopped

  # v3.0.0: core is no longer an F13 app image -- it is APISIX, a
  # file-configured API gateway that routes to the individual services.
  # Guest mode (no Keycloak) is the only profile this configurator ever
  # renders, so the *-guest.yaml files are mounted at the filenames the
  # image actually reads; the plain apisix.yaml/config.yaml (Keycloak
  # variant) are mounted too, vendored for reference / a future non-guest
  # profile, but nothing loads them yet.
  core:
    image: apache/apisix:3.15.0-ubuntu
    environment:
      APISIX_STAND_ALONE: "true"
      APISIX_PROFILE: guest
      CORS_ALLOW_ORIGINS: "http://localhost:${FRONTEND_PORT}"
    volumes:
      - ./configs/apisix/config-guest.yaml:/usr/local/apisix/conf/config.yaml:ro
      - ./configs/apisix/apisix-guest.yaml:/usr/local/apisix/conf/apisix.yaml:ro
      - ./configs/apisix/config.yaml:/usr/local/apisix/conf/config-keycloak-reference.yaml:ro
      - ./configs/apisix/apisix.yaml:/usr/local/apisix/conf/apisix-keycloak-reference.yaml:ro
    ports:
      - "${CORE_PORT}:8000"
    depends_on:
      feedback-db:
        condition: service_healthy
      chat:
        condition: service_started
    restart: unless-stopped

  chat:
    image: ${CHAT_IMAGE}
    platform: linux/amd64
    volumes:
      - ./configs/chat:/chat/configs:ro
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      opa:
        condition: service_healthy
    restart: unless-stopped

  # v3.0.0: chat refuses to start without service_endpoints.opa in its
  # general.yml (KeyError: 'opa' at boot, regardless of whether agentic
  # tools are used). Tool permissions moved out of agentic_chat.yml's
  # `role` keys and into this policy set.
  opa:
    image: registry.opencode.de/f13/devops-tools/dockerhub-images/opa:1.18.1-debug
    command:
      - "run"
      - "--server"
      - "--addr=:${OPA_PORT}"
      - "--watch"
      - "--set=decision_logs.console=true"
      - "/policies"
    volumes:
      - ./opa/policies:/policies:ro
    healthcheck:
      test: ["CMD", "/opa", "eval", "1"]
      interval: 5s
      timeout: 3s
      retries: 5
    restart: unless-stopped

  feedback-db:
    image: postgres:18-alpine
    environment:
      POSTGRES_DB: feedback
      POSTGRES_USER: member
      POSTGRES_PASSWORD: ${FEEDBACK_DB_PASSWORD}
    volumes:
      # postgres 18 moved the mount point. Earlier images took the data dir
      # directly (/var/lib/postgresql/data); 18+ expects a single mount one
      # level up and places data in a subdirectory, so pg_upgrade --link can
      # work without crossing a mount boundary. Mounting the old path against
      # an 18 image makes the container refuse to start:
      #   "There appears to be PostgreSQL data in /var/lib/postgresql/data
      #    (unused mount/volume)"
      # Matches core v3.0.0's own compose.
      - feedback-db-data:/var/lib/postgresql
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "member"]
      interval: 10s
      timeout: 5s
      retries: 5
      # Without a start_period the first probes race initdb and the container
      # is marked unhealthy before it has finished bootstrapping, which fails
      # every dependant with "dependency failed to start".
      start_period: 15s
    restart: unless-stopped

  # v3.0.0: feedback is a new service in the minimal stack. The secrets
  # target path (/core/secrets/...) is upstream's own path, not a typo we
  # introduced -- ported verbatim from core v3.0.0's docker-compose.yml.
  feedback:
    image: registry.opencode.de/f13/microservices/feedback:v1.0.1
    depends_on:
      feedback-db:
        condition: service_healthy
    secrets:
      - source: feedback_db.secret
        target: /core/secrets/feedback_db.secret
    volumes:
      - ./configs:/feedback/configs:ro
    restart: unless-stopped

  # v3.0.0: path AND tag corrected -- upstream's own docker-compose.yml pins
  # v1.2.1, but the F13 compatibility matrix (Stand 31.08.2026, more recent
  # than the v3.0.0 tag cut) specifies v1.2.2 as the matrix-tested pairing
  # for core v3.0.0 + chat v3.0.0; following the matrix per the PRD.
  ollama-mock:
    image: registry.opencode.de/f13/microservices/builder-images/ollama-mock:v1.2.2
    platform: linux/amd64
    profiles:
      - mock
    restart: unless-stopped

volumes:
  feedback-db-data:

secrets:
  feedback_db.secret:
    file: ./secrets/feedback_db.secret
