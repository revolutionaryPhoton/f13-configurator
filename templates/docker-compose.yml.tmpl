services:
  frontend:
    image: registry.opencode.de/f13/microservices/frontend/main:latest
    platform: linux/amd64
    environment:
      KEYCLOAK_DISABLED: "true"
    ports:
      - "${FRONTEND_PORT}:9999"
    depends_on:
      - core
    restart: unless-stopped

  core:
    image: registry.opencode.de/f13/microservices/core/main:latest
    platform: linux/amd64
    volumes:
      - ./configs/core:/core/configs:ro
      - ./secrets:/core/secrets:ro
    ports:
      - "${CORE_PORT}:8000"
    depends_on:
      feedback-db:
        condition: service_healthy
      chat:
        condition: service_started
    restart: unless-stopped

  chat:
    image: ${CHAT_IMAGE}
    platform: linux/amd64
    volumes:
      - ./configs/chat:/chat/configs:ro
    extra_hosts:
      - "host.docker.internal:host-gateway"
    restart: unless-stopped

  feedback-db:
    image: postgres:16-alpine
    environment:
      POSTGRES_DB: feedback
      POSTGRES_USER: member
      POSTGRES_PASSWORD: ${FEEDBACK_DB_PASSWORD}
    volumes:
      - feedback-db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "member"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  ollama-mock:
    image: registry.opencode.de/f13/microservices/base-images/ollama-mock-f13:1.2.0
    platform: linux/amd64
    profiles:
      - mock
    restart: unless-stopped

volumes:
  feedback-db-data:
